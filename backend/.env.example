# =============================================================================
# VakilConnect backend — environment template
#
# Copy to `.env` and fill in. `.env` is gitignored; never commit real values.
#
# Spring Boot does not read .env files natively. Either export these into the
# environment before starting, or use a loader:
#
#   set -a && source .env && set +a && ./mvnw spring-boot:run
#
# Every value below is read by `application.yaml` or an @Value in the code.
# Defaults shown in [brackets] apply when the variable is unset.
# =============================================================================


# -----------------------------------------------------------------------------
# REQUIRED — the application will not start without this
# -----------------------------------------------------------------------------

# Signing key for JWTs. Deliberately has NO default: a committed fallback secret
# is a fallback nobody ever changes, so the app fails fast instead.
#
# Generate one:  openssl rand -base64 32
#
# Rotating it invalidates every issued token, signing everyone out. There is no
# refresh endpoint, so treat rotation as a forced logout event.
JWT_SECRET=


# -----------------------------------------------------------------------------
# Database
#
# The schema is owned by Flyway (backend/src/main/resources/db/migration) and
# Hibernate runs with ddl-auto: validate. The application will refuse to start
# if the schema does not match the entities. Do NOT point this at a database
# whose schema was created by hand.
# -----------------------------------------------------------------------------

DB_URL=jdbc:postgresql://localhost:5432/vakilconnect   # [jdbc:postgresql://localhost:5432/vakilconnect]
DB_USERNAME=postgres                                   # [arshraj]
DB_PASSWORD=                                           # [empty]


# -----------------------------------------------------------------------------
# JWT lifetime
# -----------------------------------------------------------------------------

# Milliseconds. 86400000 = 24 hours.
# There is no refresh token, so this is the full session length; expiry surfaces
# to the user as a redirect to the login page.
JWT_EXPIRATION=86400000                                # [86400000]


# -----------------------------------------------------------------------------
# CORS
#
# The browser origin the frontend is served from. Must match exactly, including
# scheme and port. A mismatch shows up as a CORS error in the browser console
# while the API itself looks healthy.
# -----------------------------------------------------------------------------

APP_CORS_ALLOWED_ORIGINS=http://localhost:3000         # [http://localhost:3000]


# -----------------------------------------------------------------------------
# Admin bootstrap
#
# On startup, AdminBootstrapRunner creates an ADMIN account if none exists with
# this email. Idempotent: restarting does not create duplicates, and it never
# overwrites an existing account.
#
# ADMIN accounts cannot be created through the public API by design. This is the
# only way to get the first one.
#
# LOCKOUT RECOVERY: if you deactivate the last admin, restart the app with a
# DIFFERENT ADMIN_EMAIL — the runner keys on the email, so a new admin is
# created. No direct database access is needed.
# -----------------------------------------------------------------------------

ADMIN_EMAIL=admin@vakilconnect.local
ADMIN_PASSWORD=
ADMIN_FULL_NAME=Platform Administrator
ADMIN_PHONE_NUMBER=9999999999


# -----------------------------------------------------------------------------
# Actuator / metrics  (see backend/docs/MIGRATION-OPERATIONS.md)
#
# Actuator runs on its own port, exposing only health, info and prometheus.
# It is NOT reachable on the application port, so the JWT filter chain is
# untouched — and there is NO AUTHENTICATION on this port. The network is the
# only access control.
#
# 127.0.0.1 is correct for a sidecar scraper sharing the network namespace.
# For Prometheus scraping a pod IP directly, set 0.0.0.0 AND add a NetworkPolicy
# restricting ingress on this port to the monitoring namespace. Exposing it
# publicly publishes operational counters to anyone who asks.
# -----------------------------------------------------------------------------

MANAGEMENT_PORT=9091                                   # [9091]
MANAGEMENT_ADDRESS=127.0.0.1                           # [127.0.0.1]


# -----------------------------------------------------------------------------
# Reference-data migration observability
#
# How long a reconciliation report is cached before the gauges re-query. The
# report is nine aggregates over `lawyers` and `users`; this decouples the
# Prometheus scrape interval from the query interval. ISO-8601 duration.
#
# Only relevant while the Phase 2H cleanup gate is open. Leave at the default
# unless `lawyers` grows past roughly a million rows.
# -----------------------------------------------------------------------------

MIGRATION_RECONCILIATION_TTL=PT5M                      # [PT5M]
