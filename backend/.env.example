# =============================================================================
# VakilConnect backend — environment template
#
# Copy to `.env` and fill in. `.env` is gitignored; never commit real values.
#
# Spring Boot does not read .env files natively. Either export these into the
# environment before starting, or use a loader:
#
#   set -a && source .env && set +a && ./mvnw spring-boot:run
#
# Every value below is read by `application.yaml` or an @Value in the code.
# Defaults shown in [brackets] apply when the variable is unset.
# =============================================================================


# -----------------------------------------------------------------------------
# REQUIRED — the application will not start without this
# -----------------------------------------------------------------------------

# Signing key for JWTs. Deliberately has NO default: a committed fallback secret
# is a fallback nobody ever changes, so the app fails fast instead.
#
# Generate one:  openssl rand -base64 32
#
# Rotating it invalidates every issued token, signing everyone out. There is no
# refresh endpoint, so treat rotation as a forced logout event.
JWT_SECRET=


# -----------------------------------------------------------------------------
# Database
#
# The schema is owned by Flyway (backend/src/main/resources/db/migration) and
# Hibernate runs with ddl-auto: validate. The application will refuse to start
# if the schema does not match the entities. Do NOT point this at a database
# whose schema was created by hand.
# -----------------------------------------------------------------------------

DB_URL=jdbc:postgresql://localhost:5432/vakilconnect   # [jdbc:postgresql://localhost:5432/vakilconnect]
DB_USERNAME=postgres                                   # [arshraj]
DB_PASSWORD=                                           # [empty]


# -----------------------------------------------------------------------------
# JWT lifetime
# -----------------------------------------------------------------------------

# Milliseconds. 86400000 = 24 hours.
# There is no refresh token, so this is the full session length; expiry surfaces
# to the user as a redirect to the login page.
JWT_EXPIRATION=86400000                                # [86400000]


# -----------------------------------------------------------------------------
# CORS
#
# The browser origin the frontend is served from. Must match exactly, including
# scheme and port. A mismatch shows up as a CORS error in the browser console
# while the API itself looks healthy.
# -----------------------------------------------------------------------------

APP_CORS_ALLOWED_ORIGINS=http://localhost:3000         # [http://localhost:3000]


# -----------------------------------------------------------------------------
# Admin bootstrap
#
# On startup, AdminBootstrapRunner creates an ADMIN account if none exists with
# this email. Idempotent: restarting does not create duplicates, and it never
# overwrites an existing account.
#
# ADMIN accounts cannot be created through the public API by design. This is the
# only way to get the first one.
#
# LOCKOUT RECOVERY: if you deactivate the last admin, restart the app with a
# DIFFERENT ADMIN_EMAIL — the runner keys on the email, so a new admin is
# created. No direct database access is needed.
# -----------------------------------------------------------------------------

ADMIN_EMAIL=admin@vakilconnect.local
ADMIN_PASSWORD=
ADMIN_FULL_NAME=Platform Administrator
ADMIN_PHONE_NUMBER=9999999999


# -----------------------------------------------------------------------------
# Actuator / metrics  (see backend/docs/MIGRATION-OPERATIONS.md)
#
# Actuator runs on its own port, exposing only health, info and prometheus.
# It is NOT reachable on the application port, so the JWT filter chain is
# untouched — and there is NO AUTHENTICATION on this port. The network is the
# only access control.
#
# 127.0.0.1 is correct for a sidecar scraper sharing the network namespace.
# For Prometheus scraping a pod IP directly, set 0.0.0.0 AND add a NetworkPolicy
# restricting ingress on this port to the monitoring namespace. Exposing it
# publicly publishes operational counters to anyone who asks.
# -----------------------------------------------------------------------------

MANAGEMENT_PORT=9091                                   # [9091]
MANAGEMENT_ADDRESS=127.0.0.1                           # [127.0.0.1]


# -----------------------------------------------------------------------------
# Reference-data migration observability
#
# How long a reconciliation report is cached before the gauges re-query. The
# report is nine aggregates over `lawyers` and `users`; this decouples the
# Prometheus scrape interval from the query interval. ISO-8601 duration.
#
# Only relevant while the Phase 2H cleanup gate is open. Leave at the default
# unless `lawyers` grows past roughly a million rows.
# -----------------------------------------------------------------------------

MIGRATION_RECONCILIATION_TTL=PT5M                      # [PT5M]


# =============================================================================
# IDENTITY - email verification and password reset  (schema landed in V7)
#
# Nothing reads these yet. They are declared now so that the configuration
# surface and the schema ship together and later phases are pure Java.
#
# Design: backend/docs/IDENTITY-TDD.md
# =============================================================================


# -----------------------------------------------------------------------------
# Token hashing
#
# HMAC key applied to verification and reset tokens before they are stored, so
# that a leaked database dump alone does not yield usable links - the pepper
# lives in the environment, not in the database.
#
# Generate one:  openssl rand -base64 32
#
# REQUIRED. TokenHasher now exists, so an empty pepper would mean hashing under
# a known-empty key - worse than not hashing, because it looks protected. The
# application refuses to start without it, exactly like JWT_SECRET.
#
# ROTATING IT KILLS EVERY OUTSTANDING LINK immediately. Every user mid-way
# through verification or reset has to request a new one. Same class of event as
# rotating JWT_SECRET, which is a forced logout.
# -----------------------------------------------------------------------------

TOKEN_PEPPER=


# -----------------------------------------------------------------------------
# Link destination
#
# The FRONTEND origin - NOT the API. Verification and reset emails link to
# Next.js pages, which read the token from the query string and POST it to the
# backend. A GET must never consume a token: mail scanners and link prefetchers
# open links before a human does.
#
# Getting this wrong in production sends every user to localhost. There is no
# way for the backend to detect that.
# -----------------------------------------------------------------------------

APP_PUBLIC_BASE_URL=http://localhost:3000              # [http://localhost:3000]


# -----------------------------------------------------------------------------
# The login gate
#
# false -> tokens are issued and emails are sent, but unverified users can still
#          log in. This is the deploy-time default on purpose: it lets email
#          delivery be proven in production before anything is gated on it.
#
# true  -> unverified users are rejected at login with EMAIL_NOT_VERIFIED.
#
# Flipping it is a configuration change, not a deploy, which makes it the
# fastest rollback this feature has. Do not set it true until
# vakilconnect_identity_email_send_total shows near-100% delivery.
# -----------------------------------------------------------------------------

EMAIL_VERIFICATION_ENFORCED=false                      # [false]


# -----------------------------------------------------------------------------
# Lifetimes and cooldowns (ISO-8601 durations)
#
# VERIFICATION_TOKEN_TTL  24h. Long enough to survive "I'll do it tonight",
#                         short enough that a link in an abandoned inbox is not
#                         indefinitely live. Resending is cheap.
#
# RESET_TOKEN_TTL         30m, deliberately not 15. Delivery lag plus a user
#                         reading on a phone twenty minutes later is ordinary,
#                         and every expiry sends ANOTHER email - which erodes
#                         the security the shorter window was meant to buy.
#
# RESEND_COOLDOWN         Minimum gap between verification emails for one
#                         account. Enforced from the newest row in email_tokens,
#                         not an in-memory counter, so a restart cannot reset it
#                         and be used to mail-bomb somebody.
# -----------------------------------------------------------------------------

VERIFICATION_TOKEN_TTL=PT24H                           # [PT24H]
RESET_TOKEN_TTL=PT30M                                  # [PT30M]
RESEND_COOLDOWN=PT60S                                  # [PT60S]


# -----------------------------------------------------------------------------
# Email squatting
#
# `users.email` is UNIQUE and registration does not require verification, so
# without this an attacker could register someone else's address, never verify,
# and block the real owner permanently.
#
# After this long, a re-registration may claim an unverified account. Kept much
# longer than VERIFICATION_TOKEN_TTL on purpose: a token expiring does not mean
# the account is abandoned, and a short window turns a one-off block into a
# repeatable grief loop against a slow but legitimate user.
# -----------------------------------------------------------------------------

TAKEOVER_THRESHOLD=P7D                                 # [P7D]


# -----------------------------------------------------------------------------
# Housekeeping
#
# IDENTITY_PURGE_ENABLED  The purge is @Scheduled and runs on EVERY instance it
#                         is enabled on. The deletes are idempotent so nothing
#                         breaks, but set this false on all but one replica
#                         until there is a leader election. Same single-instance
#                         assumption as the rate limiter.
#
# TOKEN_PURGE_RETENTION   How long consumed and superseded tokens are kept. They
#                         are the audit trail for "who requested a reset, from
#                         where, and did they use it".
#
# UNVERIFIED_PURGE_AFTER  How long an unverified account survives. MUST exceed
#                         TAKEOVER_THRESHOLD, or an address would be deleted
#                         before a legitimate re-registration could claim it.
# -----------------------------------------------------------------------------

IDENTITY_PURGE_ENABLED=true                            # [true]
TOKEN_PURGE_RETENTION=P30D                             # [P30D]
UNVERIFIED_PURGE_AFTER=P30D                            # [P30D]
