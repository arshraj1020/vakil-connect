# Compose-level variables ONLY - read by docker-compose.yml itself to
# provision the `db` service and thread the same credentials into `backend`.
# This is NOT read by the backend or frontend applications directly; they
# have their own .env files (backend/.env.example, frontend/.env.example).
#
# Copy to .env in this directory before running `docker compose up`:
#   cp .env.example .env

POSTGRES_USER=vakilconnect
POSTGRES_PASSWORD=vakilconnect

# Passed through to the frontend build as NEXT_PUBLIC_API_BASE_URL (baked in
# at build time - see frontend/Dockerfile). Only needs changing if you remap
# the backend's published port away from 8080.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
